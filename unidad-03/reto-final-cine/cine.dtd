<!ELEMENT cine (informacion, cartelera, salas, sesiones, reservas)>

<!ELEMENT informacion (nombre, direccion, localidad, telefono)>
<!ELEMENT nombre (#PCDATA)>
<!ELEMENT direccion (#PCDATA)>
<!ELEMENT localidad (#PCDATA)>
<!ELEMENT telefono (#PCDATA)>

<!ELEMENT cartelera (pelicula+)>
<!ELEMENT pelicula (titulo, director, genero, min_duracion, fecha_estreno, sinopsis?)>
<!ELEMENT titulo (#PCDATA)>
<!ELEMENT director (#PCDATA)>
<!ELEMENT genero (#PCDATA)>
<!ELEMENT min_duracion (#PCDATA)> 
<!ELEMENT fecha_estreno (#PCDATA)>
<!ELEMENT sinopsis (#PCDATA)>

<!ELEMENT salas (sala+)>
<!ELEMENT sala (num_sala, capacidad, butacas)>
<!ELEMENT num_sala (#PCDATA)>
<!ELEMENT capacidad (#PCDATA)>
<!ELEMENT butacas (butaca+)>
<!ELEMENT butaca (fila, num_asiento)>
<!ELEMENT fila (#PCDATA)>
<!ELEMENT num_asiento (#PCDATA)>

<!ELEMENT sesiones (sesion+)>
<!ELEMENT sesion (fecha_proyeccion, hora_inicio, precio_entrada)>
<!ELEMENT fecha_proyeccion (#PCDATA)>
<!ELEMENT hora_inicio (#PCDATA)>
<!ELEMENT precio_entrada (#PCDATA)>

<!ELEMENT reservas (reserva*)>
<!ELEMENT reserva (nombre, email, fecha_reserva, entradas)> 
<!ELEMENT email (#PCDATA)>
<!ELEMENT fecha_reserva (#PCDATA)>
<!ELEMENT entradas (entrada+)>
<!ELEMENT entrada (#PCDATA)>


<!ENTITY nombreCine 'Cinepolis'>


<!ATTLIST cine
    id ID #REQUIRED
    nombre CDATA #REQUIRED>

<!ATTLIST pelicula
    id ID #REQUIRED
    clasificacion (TP | 7 | 12 | 16 | 18) '18'
    idioma (ES | VOSE | VO) 'ES'
    disponible (true | false) 'true'>

<!ATTLIST sala
    id ID #REQUIRED>

<!ATTLIST butaca
    id ID #REQUIRED
    tipo (normal | premium | adaptada) 'normal'>

<!ATTLIST sesion
    id ID #REQUIRED
    pelicula IDREF #REQUIRED
    sala IDREF #REQUIRED>

<!ATTLIST precio_entrada
    moneda (EUR | GBP) 'EUR'>

<!ATTLIST reserva
    id ID #REQUIRED
    sesion IDREF #REQUIRED
    estado (pendiente | confirmada | cancelada) 'pendiente'>

<!ATTLIST entrada
    butaca IDREF #REQUIRED
    tipo (general | infantil | reducida) 'general'>