<!ELEMENT carta (informacion, seccion+)> <!-- Signo +: aparece una o mas veces -->

<!ELEMENT informacion (nombre, ubicacion)>
<!ELEMENT nombre (#PCDATA)>
<!ELEMENT ubicacion (#PCDATA)>

<!ELEMENT seccion (titulo, plato+)>
<!ELEMENT titulo (#PCDATA)>

<!ELEMENT plato (nombre, descripcion, precio)>
<!-- No ponemos la linea de nombre pq coge la de arriba -->
<!ELEMENT descripcion (#PCDATA)>
<!ELEMENT precio (#PCDATA)>

<!-- CARDINALIDADES -->
<!-- Sin simbolo: aparece exactamente una vez -->
<!-- ?: aparece cero o una vez -->
<!-- *: aparece cero o mas veces -->
<!-- +: aparece una o mas veces -->

<!ATTLIST carta 
    nombre CDATA #REQUIRED>

<!ATTLIST seccion
    tipo (entrantes | principales | bebidas | postres ) #REQUIRED>

<!ATTLIST plato
    id ID #REQUIRED
    vegano (TRUE | FALSE) 'FALSE'
    recomendado (TRUE | FALSE) 'FALSE'
    frio (TRUE | FALSE) 'FALSE'>

<!ATTLIST precio
    moneda (EUR | PLZ | GBP) 'EUR'> <!-- EUR: euro; PLZ: moneda de polonia; GBP: libra -->